              "raw": "{{base_url}}/api/v1/users",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"name\": \"Postman Test Officer\",\n    \"email\": \"postman.test@dofi.gov.bn\",\n    \"password\": \"Password123!\",\n    \"password_confirmation\": \"Password123!\",\n    \"employee_id\": \"DOFI-POSTMAN-1\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
