      ]
    },
    {
      "name": "Z - Sign Out (run last)",
      "description": "Kept as the final folder so it runs after Permissions/Roles/Users. Signing out revokes jwt_token (devise-jwt JTI revocation), so anything run after this needs a fresh Sign In.",
      "item": [
        {
          "name": "Sign Out",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/sign_out",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "sign_out"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('jwt_token', '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - After Sign Out (401, revoked token)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
