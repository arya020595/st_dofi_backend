# Storage server. Copy to .env next to docker-compose.yml. Never commit the real .env.
# Generate secrets with: openssl rand -hex 32

# MinIO admin login. Only used on this server.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Private bucket and the app's key for it. Copy the same values to the backend .env.
MINIO_BUCKET=dofi-production-private
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=

# Public-read assets bucket and its own key. Copy the same values to the backend .env.
MINIO_ASSETS_BUCKET=dofi-production-public
MINIO_ASSETS_ACCESS_KEY_ID=
MINIO_ASSETS_SECRET_ACCESS_KEY=
