# FALLBACK ONLY (Docker variant, see docker-compose.yml). The main path is native PostgreSQL: ../README.md.
# Database server. Copy to .env next to docker-compose.yml. Never commit the real .env.
# Generate the password with: openssl rand -hex 32

# This server's private IP (the address the backend server connects to).
DB_BIND_IP=
# Becomes DATABASE_PASSWORD in the backend .env.
POSTGRES_PASSWORD=
