# Backend server. Copy to .env next to docker-compose.yml. Never commit the real .env.
# Generate secrets with: openssl rand -hex 32
# After editing, run `docker compose up -d` again.

# Image tag to run. `production` = latest release; set a git SHA to pin or roll back.
IMAGE_TAG=production

# --- Rails ---
RAILS_ENV=production
# From config/master.key. Without it the app does not boot.
RAILS_MASTER_KEY=
DEVISE_JWT_SECRET_KEY=
# No domain or TLS yet, so plain HTTP. Set back to true once there is a certificate.
FORCE_SSL=false

# --- Database server ---
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USERNAME=dofi
# Password of the `dofi` role you created on the database server (deploy/production/database/README.md, step 3).
DATABASE_PASSWORD=
DATABASE_NAME=dofi_backend_production

# --- ROCBN company registry (read-only: the existing MySQL on the database host, not ours) ---
# The Add Profiling company lookup reads tdd_db.sync_rocbn_hotel. Ask the client for an account that holds SELECT
# on that table only, valid from the backend server's IP, then prove it with
# `docker compose run --rm --no-deps api bin/rails rocbn:check` (docs/rocbn/company-lookup.md).
# Never set ROCBN_SEED_*, ROCBN_TEST_* or ROCBN_ALLOW_SEED here: production is never seeded.
ROCBN_DB_HOST=10.252.8.23
ROCBN_DB_PORT=9139
ROCBN_DB_NAME=tdd_db
ROCBN_DB_USERNAME=
ROCBN_DB_PASSWORD=

# --- Frontend: its origin exactly as the browser shows it: scheme + host + port, no trailing slash ---
# e.g. http://10.246.8.12:4100. A different port or http vs https is a different origin and is rejected.
# Several origins: separate them with commas.
CORS_ORIGINS=
CABLE_ALLOWED_ORIGINS=

# --- Storage server (same IP in both: the backend and browsers both reach MinIO there) ---
MINIO_ENDPOINT=http://STORAGE_IP:9000
MINIO_PUBLIC_ENDPOINT=http://STORAGE_IP:9000
# The keys and bucket names below are copied from the storage server's .env.
MINIO_BUCKET=dofi-production-private
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_ASSETS_BUCKET=dofi-production-public
MINIO_ASSETS_ACCESS_KEY_ID=
MINIO_ASSETS_SECRET_ACCESS_KEY=

# --- BruneiID ---
BRUNEIID_MOCK_ENABLED=false
BRUNEIID_BASE_URL=
BRUNEIID_CLIENT_ID=
BRUNEIID_CLIENT_SECRET=
BRUNEIID_REDIRECT_URI=

# --- Active Directory (staff sign in through the directory; see docs/registration/active-directory-login.md) ---
# Production always uses the real directory. DEPLOY_ENV=production is set by docker-compose.yml, and the app
# refuses to boot with any other AD_MODE here. Do not set AD_MOCK_PASSWORD on this server.
AD_MODE=ldap
# Superadmin's real Active Directory username: required by `db:seed` on a fresh database (no placeholder is used).
ADMIN_AD_USERNAME=
AD_HOST=
AD_PORT=3269
AD_NETBIOS_DOMAIN=
AD_DNS_DOMAIN=
AD_BIND_FORMAT=netbios
# PEM of the CA that issued the directory's certificate, as a path inside the api container (see the volume
# example in docker-compose.yml)
AD_CA_FILE=
AD_CONNECT_TIMEOUT=3
AD_OPERATION_TIMEOUT=5

# --- Optional ---
SENTRY_DSN=
