# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# --- Rails ---
RAILS_ENV=development
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=dofi_backend_development
# Host-side port docker-compose.yml publishes the db container on (change if 5433 is already taken locally)
DATABASE_HOST_PORT=5433

# --- Devise / JWT ---
DEVISE_JWT_SECRET_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Cloudinary (file storage) ---
CLOUDINARY_URL=

# --- Sentry (error tracking) ---
SENTRY_DSN=

# --- BruneiID (national digital identity integration) ---
BRUNEIID_BASE_URL=
BRUNEIID_CLIENT_ID=
BRUNEIID_CLIENT_SECRET=
BRUNEIID_REDIRECT_URI=
