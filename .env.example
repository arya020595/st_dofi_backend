# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# --- Rails ---
RAILS_ENV=development
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=dofi_backend_development
# Host-side port docker-compose.yml publishes the db container on (change if 5433 is already taken locally)
DATABASE_HOST_PORT=5433

# --- Devise / JWT ---
DEVISE_JWT_SECRET_KEY=

# --- CORS ---
# Comma-separated allowlist of exact origins (scheme + host + port) permitted to call this API
# from a browser. Must include every frontend origin that calls this API directly — local dev
# server(s) AND each deployed frontend (staging/production), not just localhost. On a running
# server, edit the .env there and restart the api container; rack-cors reads this once at boot.
CORS_ORIGINS=http://localhost:5173

# --- Cloudinary (legacy file storage, being migrated to MinIO — see MINIO_* below) ---
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Uploads are stored under folder: dofi_development / dofi_staging / dofi_production
CLOUDINARY_URL=

# --- MinIO (S3-compatible object storage, file storage) ---
# Root/admin credentials for the minio container itself (used by docker-compose.staging.yml /
# docker-compose.production.yml, NOT by the Rails app — keep these separate from the scoped
# application access key below).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Scoped application access key (create via `mc admin user add`, do not use the root user here).
# Internal Docker network address of the MinIO container, e.g. http://minio:9000. Used for actual
# uploads/downloads — never reachable by a browser, so it must NOT be the value clients see.
MINIO_ENDPOINT=
# Public-facing address a browser can reach (reverse-proxied to the internal minio:9000 — see
# docs/MINIO.md). Used only to sign presigned URLs shown to clients, e.g.
# http://<server-ip-or-domain>:<proxy-port>. Leave blank to fall back to MINIO_ENDPOINT (e.g. for
# local testing of the prod image where no public reverse proxy exists).
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_REGION=us-east-1
# Use a separate bucket per environment, e.g. dofi-staging-private / dofi-production-private.
# This is the PRIVATE bucket — no anonymous access, downloads only via presigned URL through
# Api::V1::AttachmentsController. See MINIO_ASSETS_* below for the public bucket.
MINIO_BUCKET=

# Public bucket (env var kept as MINIO_ASSETS_* — see docs/MINIO.md §2 for why: MINIO_PUBLIC_ENDPOINT
# above already names a different concept, the reverse-proxy address, so the bucket-tier env vars
# stay "assets" to avoid two unrelated things both being called "public"). A separate bucket AND
# separate scoped credentials from MINIO_BUCKET above, so a leaked credential on one tier can't
# reach the other. Anonymous GetObject is granted on this bucket only (by mc-init), never on
# MINIO_BUCKET. e.g. dofi-staging-public / dofi-production-public.
MINIO_ASSETS_BUCKET=
MINIO_ASSETS_ACCESS_KEY_ID=
MINIO_ASSETS_SECRET_ACCESS_KEY=

# --- Host authorization (production only, bare dedicated servers with no managed cloud edge) ---
# Comma-separated list of hostnames this app is allowed to serve. Leave blank to disable the
# check (default, safe for staging/local). Set once the real backend domain is known.
APP_HOSTS=

# --- Sentry (error tracking) ---
SENTRY_DSN=

# --- BruneiID (national digital identity integration) ---
BRUNEIID_BASE_URL=
BRUNEIID_CLIENT_ID=
BRUNEIID_CLIENT_SECRET=
BRUNEIID_REDIRECT_URI=
