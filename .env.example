# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# --- Rails ---
RAILS_ENV=development
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=dofi_backend_development
# Host-side port docker-compose.yml publishes the db container on (change if 5433 is already taken locally)
DATABASE_HOST_PORT=5433

# --- Devise / JWT ---
DEVISE_JWT_SECRET_KEY=

# --- Mailer (password reset, etc.) ---
# Frontend URL the reset-password link in emails points to.
FRONTEND_URL=http://localhost:5173
MAILER_SENDER=no-reply@dofi.gov.bn
# Required in production for action_mailer.default_url_options (links rendered in email bodies).
MAILER_HOST=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain

# --- CORS ---
# Comma-separated allowlist of exact origins (scheme + host + port) permitted to call this API
# from a browser. Must include every frontend origin that calls this API directly — local dev
# server(s) AND each deployed frontend (staging/production), not just localhost. On a running
# server, edit the .env there and restart the api container; rack-cors reads this once at boot.
CORS_ORIGINS=http://localhost:5173

# --- Cloudinary (file storage) ---
CLOUDINARY_URL=

# --- Sentry (error tracking) ---
SENTRY_DSN=

# --- BruneiID (national digital identity integration) ---
BRUNEIID_BASE_URL=
BRUNEIID_CLIENT_ID=
BRUNEIID_CLIENT_SECRET=
BRUNEIID_REDIRECT_URI=
